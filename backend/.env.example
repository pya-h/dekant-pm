# ---------- Required ----------

DATABASE_URL=postgresql://dekant_pm:dekant_pm@localhost:5432/dekant_pm
PROGRAM_ID=<your-program-id-after-anchor-deploy>
JWT_SECRET=change-me-in-production
# The protocol superuser Wallet address that bypasses all role checks (base58 public key)
SUPERADMIN_ADDRESS=<base58-pubkey-of-protocol-superadmin>


# ---------- Optional (have sensible defaults) ----------

# default: http://localhost:8899
SOLANA_RPC_URL=http://localhost:8899
# default: 4000
PORT=4000
# default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# default: development
NODE_ENV=development
# Auto-create/sync DB tables from entities (default: false); NEVER use in production — use migrations instead.
DB_SYNCHRONIZE=false
# Fee-collector keypair as JSON byte array (only needed for fee-collection cron)
COLLECTOR_KEYPAIR=[1,2,3,...,64]
# Faucet wallet keypair as JSON byte array (optional — faucet disabled if not set)
FAUCET_KEYPAIR=[1,2,3,...,64]
# Price service URL for live crypto prices (default: https://xprices.umbralabs.io)
PRICESERVICE_URL=https://xprices.umbralabs.io
