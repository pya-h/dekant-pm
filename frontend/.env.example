# Solana RPC endpoint
NEXT_PUBLIC_RPC_URL=http://localhost:8899

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# DekantPM Program ID (from `anchor deploy` or `solana program show`)
NEXT_PUBLIC_PROGRAM_ID=<your-program-id-after-anchor-deploy>

# Solana network (localnet | devnet | mainnet-beta)
NEXT_PUBLIC_NETWORK=localnet
